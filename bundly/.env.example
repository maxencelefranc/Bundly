EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ANTHROPIC_API_KEY must NOT live here with an EXPO_PUBLIC_ prefix: that would
# bundle it into the client app and expose it to anyone who inspects the build.
# When the AI feature is implemented, store the key as a Supabase Edge Function
# secret instead (`supabase secrets set ANTHROPIC_API_KEY=...`) and call it
# from server-side code only.
